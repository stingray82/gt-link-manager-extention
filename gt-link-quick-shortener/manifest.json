{
  "manifest_version": 3,
  "name": "GT Link Quick Shortener",
  "version": "1.0.0",
  "description": "Create branded short links for your current tab using GT Link Manager's WordPress REST API.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "notifications",
    "offscreen",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": [],
  "action": {
    "default_title": "Shorten with GT Link Manager",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "quick-shorten": {
      "description": "Quick shorten the current page"
    }
  }
}
